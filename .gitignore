# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python Virtual Environment
.venv/
env/
venv/
__pycache__/
*.py[cod]

# SQLite database
*.db
*.sqlite
*.sqlite3

# Large Model Weights (EasyOCR download cache)
*.pth
AI_Modules/models/easyocr/

# Document Storage
storage/documents/*
!storage/documents/.gitkeep
backend/storage/documents/*
!backend/storage/documents/.gitkeep

# IDEs & OS
.idea/

# Pytest
.pytest_cache/
.coverage
