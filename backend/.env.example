# Application Settings
PROJECT_NAME="SURAKSHIT SHRAM Backend"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="surakshit_user"
POSTGRES_PASSWORD="surakshit_password"
POSTGRES_DB="surakshit_shram_db"
# Fallback Database URL (SQLite default for local development without Postgres container)
DATABASE_URL="sqlite:///./surakshit_shram.db"

# Redis Cache Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
USE_REDIS_FALLBACK=true

# Storage Settings for Document Uploads
UPLOAD_DIR="./storage/documents"
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB limit
