# ============================================================
# SURAKSHIT SHRAM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure secret credentials locally.
# DO NOT COMMIT REAL SECRETS OR .env FILES TO GIT.
# ============================================================

# ---------- DEMO SEED CREDENTIALS (DEVELOPMENT ONLY) ----------
DEMO_ADMIN_PASSWORD=
DEMO_COMPANY_PASSWORD=
DEMO_INSPECTOR_PASSWORD=
DEMO_GOVERNMENT_PASSWORD=

# ---------- APPLICATION ----------
PROJECT_NAME="SURAKSHIT SHRAM — Labor Compliance Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# ---------- SECURITY & AUTHENTICATION ----------
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- DATABASE CONFIGURATION ----------
# Default local fallback uses SQLite; configure PostgreSQL for production.
USE_SQLITE_FALLBACK=true
SQLITE_DB_FILE="./surakshit_shram.db"
POSTGRES_SERVER="localhost"
POSTGRES_USER="surakshit"
POSTGRES_PASSWORD="surakshit_password"
POSTGRES_DB="surakshit_db"
POSTGRES_PORT=5432

# ---------- REDIS CACHE CONFIGURATION ----------
USE_REDIS_FALLBACK=true
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ---------- DOCUMENT STORAGE ----------
UPLOAD_DIR="./storage/documents"
MAX_UPLOAD_SIZE_BYTES=10485760

# ---------- AI ENGINE & GEMINI CONFIGURATION ----------
AI_MODEL_PATH="./AI_Modules/models"
GEMINI_API_KEY="your-optional-google-gemini-api-key-here"

# ---------- CORS ORIGINS ----------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
